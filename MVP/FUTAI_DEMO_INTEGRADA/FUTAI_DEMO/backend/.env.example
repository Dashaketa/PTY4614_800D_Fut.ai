# La demo/importación funciona aunque el motor esté desactivado.
FUTAI_PROCESSING_ENABLED=false
# Rutas relativas a backend. CONFIGURAR_PROCESAMIENTO.bat configura el equipo.
# FUTAI_WORKER_PYTHON=../../../Procesamiento/.venv/Scripts/python.exe
FUTAI_MODEL_PATH=../../../Procesamiento/yolov8n.pt
FUTAI_DEVICE=cpu
FUTAI_IMAGE_SIZE=640
FUTAI_CONFIDENCE=0.1
FUTAI_MAX_SPEED_KMH=45
FUTAI_MAX_UPLOAD_MB=200
FUTAI_MAX_VIDEO_SECONDS=120
FUTAI_MAX_FRAMES=0
FUTAI_WORKER_TIMEOUT_SECONDS=1800
FUTAI_MAX_PENDING_JOBS=4
FUTAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
